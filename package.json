{
  "name": "cobblelauncher",
  "version": "1.1.1",
  "description": "CobbleLauncher - Minecraft Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "eml-lib": "^2.7.4",
    "skinview3d": "^3.4.2",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.cobblelauncher.app",
    "productName": "CobbleLauncher",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pedrxzy",
        "repo": "CobbleLauncher"
      }
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
